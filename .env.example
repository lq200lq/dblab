# 复制为 .env 后按需修改。

# 平台自身数据库（存放数据源配置、密钥、授权与审计）
# 本机开发直连库主机；用 docker compose 跑时写 host.docker.internal（容器里的 localhost 是容器自己）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dblab
PORT=4000

# 以下是 docker compose 专用项，本机开发不用管。
# 自带 Postgres 时的口令（仅 --profile bundled-db 用），也是 compose 覆盖端口时的参考名
DB_PASSWORD=dblab_local_pw

# 凭据主密钥：32 字节 base64（openssl rand -base64 32）。
# 留空则落到 .data/credential-master.key（首次自动生成，权限 0600）。
# 主密钥一旦变更或丢失，既有数据源口令全部解不开。
CREDENTIAL_MASTER_KEY=
CREDENTIAL_MASTER_KEY_FILE=

# 管理端会话
SESSION_TTL_MINUTES=720
SESSION_COOKIE_NAME=dblab_session

# 初始管理员。仅在库中没有该用户时生效，之后改这里不会覆盖已有口令。
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# MCP 执行约束
MCP_MAX_SQL_BYTES=100000
MCP_MAX_ROWS=500
MCP_STATEMENT_TIMEOUT_MS=15000
MCP_SESSION_TTL_MINUTES=30

# /mcp 允许的 Host（逗号分隔，不含端口）。挡的是 DNS rebinding：
# 攻击者让 evil.com 解析到内网 IP 时，浏览器发出的 Host 与 Origin 是一致的，
# 只做同源比对看不出来，必须有这份白名单。填 * 表示不校验（只在受信网络里这么配）。
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# 被纳管数据源的连接池
POOL_MAX=4
POOL_IDLE_EVICT_MINUTES=15

# 仅在服务确实位于反向代理之后时才设为 1，否则 IP 白名单会被代理地址带偏
TRUST_PROXY=0
